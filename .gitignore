# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/

# Local / secret configuration must never be committed
config/config.local.yaml
config/*.local.yaml
config/*.local.json

# Runtime data, logs, and database artifacts
data/
logs/
*.db
*.sqlite
*.sqlite3

# Transient dual-agent worktree ownership; never commit a held lease
work/locks/WORKTREE_LEASE.yaml

# Parent repository ignores generic reports/ directories. TGrid Gate evidence
# is intentionally auditable and must remain tracked.
!work/reports/
!work/reports/**

# Editor / OS noise
.DS_Store
Thumbs.db
